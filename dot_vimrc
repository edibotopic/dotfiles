" Minimal vimrc mirroring ~/.config/nvim basics (no plugins)
set nocompatible
filetype plugin indent on
syntax on
set termguicolors
set background=dark
colorscheme zenbones

let mapleader = " "
let maplocalleader = ","

" Display
set number relativenumber
set noshowmode
set cursorline
set signcolumn=yes
set scrolloff=10
set list
set listchars=tab:\ \ ,trail:·,nbsp:␣
set breakindent
set wildmenu
set laststatus=2
set ruler
set showcmd

" Behaviour
set mouse=a
set confirm
set hidden
set backspace=indent,eol,start
set autoread
set updatetime=250
set timeout timeoutlen=300 ttimeoutlen=10
set splitright splitbelow
set noswapfile
set encoding=utf-8

" Clipboard
if has('clipboard')
  set clipboard=unnamed,unnamedplus
endif

" Search
set ignorecase smartcase
set incsearch hlsearch

" Persistent undo
if has('persistent_undo')
  let s:undodir = expand('~/.vim/undo')
  if !isdirectory(s:undodir)
    call mkdir(s:undodir, 'p')
  endif
  let &undodir = s:undodir
  set undofile
endif

" Block cursor everywhere (Windows Terminal / xterm)
let &t_SI = "\e[2 q"
let &t_EI = "\e[2 q"
let &t_SR = "\e[2 q"

" Keymaps
nnoremap <silent> <Esc> :nohlsearch<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Highlight yanked text briefly
if exists('##TextYankPost') && exists('*prop_type_add')
  augroup yank_highlight
    autocmd!
    autocmd TextYankPost * if v:event.operator ==# 'y' | silent! call s:HighlightYank() | endif
  augroup END
  function! s:HighlightYank() abort
    let l:m = matchadd('IncSearch', '\%'.line("'[").'l\%'.col("'[").'c\_.*\%'.line("']").'l\%'.col("']").'c')
    call timer_start(150, {-> matchdelete(l:m)})
  endfunction
endif
