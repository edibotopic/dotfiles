# dir search with yazi
y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# dictionary lookup
d() {
    sdcv "$1" | less
}

# git root directory
gr() {
    cd "$(git rev-parse --show-toplevel)" || return
}

# open file with helix + fzf
hf() {
    hx "$(fzf)" || return
}

# open file with nvim + fzf
nf() {
    /usr/local/bin/nvim "$(fzf)" || return
}

